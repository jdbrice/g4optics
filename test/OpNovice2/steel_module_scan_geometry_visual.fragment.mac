# Optional human geometry sanity check. This is not a statistical run.
/vis/open TSGQtZB
/vis/viewer/set/autoRefresh false
/vis/verbose errors

/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/auxiliaryEdge true
/vis/geometry/set/visibility World 0 false
/vis/geometry/set/colour SteelAbsorber 0 0.72 0.72 0.78 1.00
/vis/geometry/set/forceWireframe SteelAbsorber 0 true
/vis/geometry/set/colour Tank 0 0.10 0.35 1.00 0.82
/vis/geometry/set/forceSolid Tank 0 true
/vis/geometry/set/colour SiPM 0 0.00 1.00 0.00 1.00
/vis/geometry/set/forceSolid SiPM 0 true

# View from the downstream/-Z and +X side. This keeps back-face SiPMs in
# front of the tile while also exposing the +X edge-center convention.
# The 500 mm steel edges may sit outside the viewport by design.
/vis/viewer/set/viewpointThetaPhi 120 20
/vis/viewer/zoom 3
/vis/scene/add/axes 0 0 0 100 mm

# First flush: close detail for checking the SiPM placement(s).
/vis/viewer/set/autoRefresh true
/vis/viewer/flush

# Second flush and final interactive state: wider overview so the full steel
# footprint is obvious. Zoom in interactively to return to the detail view.
/vis/viewer/set/autoRefresh false
/vis/viewer/zoom 0.5
/vis/viewer/set/autoRefresh true
/vis/viewer/flush
/vis/verbose warnings
